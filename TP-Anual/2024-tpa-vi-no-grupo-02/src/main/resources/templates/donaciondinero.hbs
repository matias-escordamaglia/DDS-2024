{{#partial "contenido"}}
    <div class="home container-fluid">
        <div class="d-flex container-fluid flex-column flex-md-row justify-content-evenly p-0 m-0">
            <div class="d-flex flex-column flex-sm-row justify-content-center w3-animate-left w3-animate-opacity non-square-distrib" style="animation-duration: 2s;">
                <img class="img-torcida-dinero" src="/public/img/donacion-dinero-alarg.jpg" alt="donar dinero">
            </div>

            <!-- Contenedor de los campos, a la derecha de la imagen -->
            <div class="container-fluid flex-column p-5 col-md-6 w3-animate-bottom w3-animate-opacity" style="animation-duration: 2s;">
                <form id="donacionDineroForm" class="form_content" action="/donacion/dinero" method="POST">
                    <div class="container-fluid d-flex flex-column gap-3 my-3">

                        <!-- monto -->
                        <div class="group-7">
                            <div class="group-8">
                                <div class="group-wrapper">
                                    <div class="div-wrapper">
                                        <div class="group-3">
                                            <label for="monto" class="texto-label">Monto a donar</label>
                                            <input type="number" id="monto" name="monto"
                                            class="form-control"
                                            placeholder="Ingrese Monto"
                                            required
                                            min="1"
                                            max="99999"
                                            title="Debe ser un número entre 1 y 99999."
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- frecuencia -->
                        <div class="group-4">
                            <div class="group-5">
                                <div class="group-6">
                                    <label for="frecuencia" class="texto-label">Frecuencia</label>
                                    <select id="frecuencia" name="frecuencia" class="form-control" required>
                                        <option value="DIARIA">Diaria</option>
                                        <option value="SEMANAL">Semanal</option>
                                        <option value="MENSUAL">Mensual</option>
                                        <option value="ANUAL">Anual</option>
                                    </select>
                                </div>
                            </div>
                        </div>


                        <!-- fecha inicio -->
                        <div class="group-wrapper">
                            <div class="div-wrapper">
                                <div class="group-3">
                                    <label for="fecha-donacion-inicio" class="texto-label">Fecha Inicio Donacion</label>
                                    <input
                                        type="date"
                                        id="fecha-donacion-inicio"
                                        name="fecha-donacion-inicio"
                                        class="form-control"
                                        required
                                    />
                                </div>
                            </div>
                        </div>

                        <!-- fecha fin -->
                        <div class="group-wrapper">
                            <div class="div-wrapper">
                                <div class="group-3">
                                    <label for="fecha-donacion-fin" class="texto-label">Fecha Fin Donacion</label>
                                    <input
                                        type="date"
                                        id="fecha-donacion-fin"
                                        name="fecha-donacion-fin"
                                        class="form-control"
                                        required
                                    />
                                </div>
                            </div>
                        </div>

                       <h3 class="d-flex flex-row px-5 pt-5 pb-3 justify-content-center align-self-center informacion-tarjeta">Informacion de la tarjeta</h3>

                        <div class="group-7">
                            <div class="group-8">
                                <div class="div-wrapper">
                                    <div class="group-3">
                                        <label for="nro-tarjeta" class="texto-label">Nro Tarjeta</label>
                                        <input
                                            type="text"
                                            id="nro-tarjeta"
                                            name="nro-tarjeta"
                                            class="form-control"
                                            placeholder="1111 11111 111111"
                                            maxlength="17"
                                            required
                                            title="Debe ser un número con el formato 1111 11111 111111."
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- vencimiento -->
                        <div class="group-7">
                            <div class="group-8">
                                <div class="div-wrapper">
                                    <div class="group-3">
                                        <label for="vencimiento" class="texto-label">Vencimiento</label>
                                        <input
                                            type="text"
                                            id="vencimiento"
                                            name="vencimiento"
                                            class="form-control"
                                            placeholder="MM/YYYY"
                                            maxlength="7"
                                            required
                                            pattern="(0[1-9]|1[0-2])/([0-9]{4})"
                                            title="Debe ser una fecha válida en formato MM/YYYY."
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- cvc -->
                        <div class="group-7">
                            <div class="group-8">
                                <div class="group-wrapper">
                                    <div class="div-wrapper">
                                        <div class="group-3">
                                            <label for="cvc" class="texto-label">Cod.Seguridad</label>
                                            <input type="text" id="cvc" name="cvc"
                                            class="form-control"
                                            placeholder="Ingrese Cod.Seguridad"
                                            maxlength="3"
                                            required
                                            pattern="\d{3}"
                                            title="Deben ser 3 numeros."
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Botón donar -->
                        <div class="frame d-flex justify-content-center">
                            <button class="btn btn-primary btn-donar" role="button" type="submit">DONAR</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const nroTarjetaInput = document.getElementById("nro-tarjeta");
        const vencimientoInput = document.getElementById("vencimiento");

        // Formatear número de tarjeta
        nroTarjetaInput.addEventListener("input", function (event) {
            let value = nroTarjetaInput.value.replace(/\D/g, ""); // Eliminar caracteres no numéricos
            value = value.replace(/(\d{4})(\d{5})?(\d{6})?/, (match, g1, g2, g3) => {
                return [g1, g2, g3].filter(Boolean).join(" ");
            });
            nroTarjetaInput.value = value;
        });

        // Formatear vencimiento
        vencimientoInput.addEventListener("input", function () {
            let value = vencimientoInput.value.replace(/\D/g, ""); // Eliminar caracteres no numéricos
            if (value.length <= 2) {
                vencimientoInput.value = value; // Solo el mes
            } else {
                vencimientoInput.value = value.slice(0, 2) + "/" + value.slice(2, 6); // Mes/Año
            }
        });
    });
</script>

    <div id="successModal" class="modal" style="display: none;">
        <div class="modal-content">
            <p id="modalMessage">Donacion realizada exitosamente.</p>
            <button id="confirmButton">OK</button>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("donacionDineroForm");

            form.addEventListener("submit", function (event) {
                event.preventDefault(); // Evitar el envío predeterminado del formulario

                const formData = new FormData(form);
                const fechaInicio = new Date(formData.get("fecha-donacion-inicio"));
                const fechaFin = new Date(formData.get("fecha-donacion-fin"));

                if (fechaInicio >= fechaFin) {
                    alert("La fecha de inicio debe ser anterior a la fecha de fin.");
                    return;
                }

                // Enviar los datos usando fetch
                fetch(form.action, {
                    method: "POST",
                    body: formData,
                })
                    .then(response => {
                        if (response.ok) return response.json();
                        else throw new Error("Error en el envío del formulario.");
                    })
                    .then(data => {
                        const modal = document.getElementById("successModal");
                        const message = document.getElementById("modalMessage");
                        message.textContent = data.message || "Donación realizada exitosamente.";
                        modal.style.display = "flex";

                        // Handle modal confirmation button click
                        const confirmButton = document.getElementById("confirmButton");
                        confirmButton.addEventListener("click", function () {
                            modal.style.display = "none";
                            window.location.href = "/home"; // Redirect to home page
                        });

                    })
                    .catch(error => {
                        console.error("Error:", error);
                        alert("Hubo un error al enviar el formulario.");
                    });
            });
        });
    </script>


{{/partial}}

{{> templates/layout}}
