{{#partial "contenido"}}
    <div class="home container-fluid">
        <div class="d-flex container-fluid flex-column flex-md-row justify-content-evenly p-0 m-0">
            <div class="d-flex flex-column flex-sm-row justify-content-center w3-animate-left w3-animate-opacity non-square" style="animation-duration: 2s;">
                <img class="img-torcida" src="/public/img/donacion-heladera-alarg.jpg" alt="colocar heladera">
            </div>

            <!-- Contenedor de los campos, a la derecha de la imagen -->
            <div class="container-fluid flex-column p-5 col-md-6 w3-animate-bottom w3-animate-opacity" style="animation-duration: 2s;">
                <form id="donacionHeladeraForm" class="form_content" action="/donacion/heladera" method="POST">
                    <div class="container-fluid d-flex flex-column gap-3 my-3; ">

                        <!--nombre heladera-->>
                        <div class="group-7">
                            <div class="group-8">
                                <div class="div-wrapper">
                                    <div class="group-3">
                                        <label for="nombre-heladera" class="texto-label">Nombre Heladera</label>
                                        <input
                                            type="text"
                                            id="nombre-heladera"
                                            name="nombre-heladera"
                                            class="form-control"
                                            placeholder="Ingrese nombre"
                                            maxLenght= "20"
                                            required
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="direccion-group">
                            <!-- Ciudad y Localidad -->
                            <div class="flex-row">
                                <div class="form-group">
                                    <label for="ciudad" class="texto-label">Ciudad</label>
                                    <input
                                        type="text"
                                        id="ciudad"
                                        name="ciudad"
                                        class="form-control"
                                        placeholder="Ingrese la ciudad"
                                        required
                                        pattern="[A-Za-z\s]+"
                                        title="Ingrese solo letras y espacios."
                                    />
                                </div>
                                <div class="form-group">
                                    <label for="localidad" class="texto-label">Localidad</label>
                                    <input
                                        type="text"
                                        id="localidad"
                                        name="localidad"
                                        class="form-control"
                                        placeholder="Ingrese la localidad"
                                        required
                                        pattern="[A-Za-z\s]+"
                                        title="Ingrese solo letras y espacios."
                                    />
                                </div>
                            </div>
                            <!-- Calle y Altura -->
                            <div class="flex-row">
                                <div class="form-group">
                                    <label for="calle" class="texto-label">Calle</label>
                                    <input
                                        type="text"
                                        id="calle"
                                        name="calle"
                                        class="form-control"
                                        placeholder="Ingrese la calle"
                                        required
                                        pattern="[A-Za-z\s]+"
                                        title="Ingrese solo letras y espacios."
                                    />
                                </div>
                                <div class="form-group">
                                    <label for="altura" class="texto-label">Altura</label>
                                    <input
                                        type="number"
                                        id="altura"
                                        name="altura"
                                        class="form-control"
                                        placeholder="Ingrese la altura"
                                        required
                                        min="1"
                                        max="99999"
                                        title="Ingrese un número entre 1 y 99999."
                                    />
                                </div>
                            </div>
                        </div>


                        <!-- capacidad -->
                        <div class="group-7">
                            <div class="group-8">
                                <div class="group-wrapper">
                                    <div class="div-wrapper">
                                        <div class="group-3">
                                            <label for="capacidad-heladera" class="texto-label">Capacidad de heladera</label>
                                            <div class="input-group">
                                                <input
                                                    type="number"
                                                    id="capacidad-heladera"
                                                    name="capacidad-heladera"
                                                    class="form-control"
                                                    placeholder="Ingrese capacidad"
                                                    required
                                                    min="1"
                                                    max="600"
                                                    title="Debe ser un número entre 1 y 600 litros."
                                                />
                                                <span class="input-group-text">litros</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <!-- fecha colocacion -->
                        <div class="group-wrapper">
                            <div class="div-wrapper">
                                <div class="group-3">
                                    <label for="fecha-colocacion" class="texto-label">Fecha Colocacion</label>
                                    <input
                                        type="date"
                                        id="fecha-colocacion"
                                        name="fecha-colocacion"
                                        class="form-control"
                                        required
                                    />
                                </div>
                            </div>
                        </div>

                        <!-- Botón donar -->
                        <div class="frame d-flex justify-content-center">
                            <button class="btn btn-primary btn-donar" role="button" type="submit">DONAR</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.getElementById("nombre-heladera").addEventListener("blur", function () {
            this.value = this.value
                .toLowerCase()
                .replace(/\b\w/g, (char) => char.toUpperCase());
        });
    </script>

    <div id="successModal" class="modal" style="display: none;">
        <div class="modal-content">
            <p id="modalMessage">Donacion realizada exitosamente.</p>
            <button id="confirmButton">OK</button>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("donacionHeladeraForm");

            form.addEventListener("submit", function (event) {
                event.preventDefault(); // Evitar el envío predeterminado del formulario

                const formData = new FormData(form);
                const fechaInicio = new Date(formData.get("fecha-donacion-inicio"));
                const fechaFin = new Date(formData.get("fecha-donacion-fin"));

                if (fechaInicio >= fechaFin) {
                    alert("La fecha de inicio debe ser anterior a la fecha de fin.");
                    return;
                }

                // Enviar los datos usando fetch
                fetch(form.action, {
                    method: "POST",
                    body: formData,
                })
                    .then(response => {
                        if (response.ok) return response.json();
                        else throw new Error("Error en el envío del formulario.");
                    })
                    .then(data => {
                        const modal = document.getElementById("successModal");
                        const message = document.getElementById("modalMessage");
                        message.textContent = data.message || "Donación realizada exitosamente.";
                        modal.style.display = "flex";

                        // Handle modal confirmation button click
                        const confirmButton = document.getElementById("confirmButton");
                        confirmButton.addEventListener("click", function () {
                            modal.style.display = "none";
                            window.location.href = "/home"; // Redirect to home page
                        });

                    })
                    .catch(error => {
                        console.error("Error:", error);
                        alert("Hubo un error al enviar el formulario.");
                    });
            });
        });
    </script>

{{/partial}}

{{> templates/layout}}
