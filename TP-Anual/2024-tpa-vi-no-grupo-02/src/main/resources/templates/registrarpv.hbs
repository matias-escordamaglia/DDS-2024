{{#partial "contenido"}}
        <div class="container-report">
            <p class="form_title">Registrar Persona Vulnerable</p>

            <form class="form_content" action="/personavulnerable" method="POST" enctype="multipart/form-data">
                <div class="form_fields">
                    <div class="form_field">
                        <label class="form_label">Nombre</label>
                        <input type="text" name="nombre" placeholder="Value" required>
                    </div>
                    <div class="form_field">
                        <label class="form_label">Apellido</label>
                        <input type="text" name="apellido" placeholder="Value" required>
                    </div>
                    <div class="form_field">
                        <label class="form_label">Edad</label>
                        <input type="number" name="edad" placeholder="Value" required>
                    </div>
                    <div class="form_field">
                        <label class="form_label">Tipo de documento</label>
                        <select name="tipoDocumento" required>
                            <option value="">Elije una opción</option>
                            <option value="CEDULA">Cédula</option>
                            <option value="DNI">DNI</option>
                            <option value="LIBRETA_CIVICA">Libreta Cívica</option>
                            <option value="LIBRETA_ENROLAMIENTO">Libreta de Enrolamiento</option>
                        </select>
                    </div>
                    <div class="form_field">
                        <label class="form_label">Nro de documento</label>
                        <input type="number" name="numeroDocumento" placeholder="Value" required>
                    </div>
                    <div class="form_field">
                        <label><input type="checkbox" name="situacionCalle"> No está en situación de calle</label>
                    </div>
                    <div class="form_field">
                        <label class="form_label">Dirección</label>
                        <input type="text" name="direccion" placeholder="Calle, Altura, Ciudad, Localidad" required>
                    </div>
                    <div class="form_field">
                        <label><input type="checkbox" name="tieneHijos"> Tiene menores a cargo</label>
                    </div>
                    <div class="form_field">
                        <label class="form_label">Cantidad de menores</label>
                        <input type="number" name="cantidadHijos" placeholder="Value" min="0">
                    </div>
                </div>

                <div class="image_section">
                    <img src="../public/img/imagen-camara.png" alt="Camera Icon" class="camera_icon">
                    <button type="button" class="photo_button">
                        <img src="../public/img/camera.png" alt="Camera Icon"> Tomar foto
                    </button>
                    <button type="button" class="attach_button">
                        <img src="../public/img/attach.png" alt="Attach Icon"> Adjuntar
                    </button>
                </div>
                <button type="submit" class="submit_button">Registrar</button>
            </form>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const situacionCalleCheckbox = document.querySelector('input[name="situacionCalle"]');
                const tieneHijosCheckbox = document.querySelector('input[name="tieneHijos"]');
                const direccionField = document.querySelector('input[name="direccion"]').closest(".form_field");
                const cantidadHijosField = document.querySelector('input[name="cantidadHijos"]').closest(".form_field");

                // Initially hide the conditional fields
                direccionField.classList.add("hidden");
                cantidadHijosField.classList.add("hidden");

                // Toggle visibility based on checkbox states
                situacionCalleCheckbox.addEventListener("change", function () {
                    if (this.checked) {
                        direccionField.classList.remove("hidden");
                    } else {
                        direccionField.classList.add("hidden");
                        document.querySelector('input[name="direccion"]').value = null;
                    }
                });

                tieneHijosCheckbox.addEventListener("change", function () {
                    if (this.checked) {
                        cantidadHijosField.classList.remove("hidden");
                    } else {
                        cantidadHijosField.classList.add("hidden");
                        document.querySelector('input[name="cantidadHijos"]').value = 0;
                    }
                });
            });
        </script>
{{/partial}}

{{> templates/layout}}
