{{#partial "contenido"}}
<div class="home container-fluid">
    <div class="d-flex container-fluid flex-column flex-md-row justify-content-evenly p-0 m-0">
        <!-- Imagen a la izquierda -->
        <div class="d-flex flex-column flex-sm-row justify-content-center w3-animate-left w3-animate-opacity non-square-distrib" style="animation-duration: 2s;">
            <img class="img-torcida" src="/public/img/donacion-vianda-alarg.jpg" alt="donacion vianda">
        </div>

        <!-- Contenedor de los campos a la derecha -->
        <div class="container-fluid flex-column p-5 col-md-6 w3-animate-bottom w3-animate-opacity" style="animation-duration: 2s;">
            <form id="donacionViandaForm" class="form_content" action="/donacion/vianda" method="POST">
                <div class="container-fluid d-flex flex-column gap-3 my-3">

                    <!-- Nombre heladera destino -->
                    <div class="d-flex flex-column w-100">
                        <label for="searchHeladeraDestino" class="texto-label">Heladera Destino</label>
                        <div class="position-relative">
                            <input
                                type="text"
                                id="searchHeladeraDestino"
                                placeholder="Heladera Destino"
                                class="form-control"
                                autocomplete="off"
                                required
                                title="Ingrese al menos 3 letras."
                            />
                            <select
                                name="nombre-heladera-destino"
                                id="nombre-heladera-destino"
                                class="form-select position-absolute w-100 d-none mt-1"
                            >
                                <!-- Opciones dinámicas -->
                            </select>
                        </div>
                    </div>

                    <!-- Fecha donación -->
                    <div class="d-flex flex-column w-100">
                        <label for="fecha-donacion" class="texto-label">Fecha Donación</label>
                        <input
                            type="date"
                            id="fecha-donacion"
                            name="fecha-donacion"
                            class="form-control"
                            required
                        />
                    </div>

                    <!-- Comida -->
                    <div class="d-flex flex-column w-100">
                        <label for="searchComidaOrigen" class="texto-label">Comida</label>
                        <div class="position-relative">
                            <input
                                type="text"
                                id="searchComidaOrigen"
                                placeholder="Comida"
                                class="form-control"
                                autocomplete="off"
                                required
                                title="Ingrese al menos 3 letras."
                            />
                            <select
                                name="nombre-comida-origen"
                                id="nombre-comida-origen"
                                class="form-select position-absolute w-100 d-none mt-1"
                            >
                                <!-- Opciones dinámicas -->
                            </select>
                        </div>
                    </div>

                    <!-- Fecha caducación -->
                    <div class="d-flex flex-column w-100">
                        <label for="fecha-caducacion" class="texto-label">Fecha Caducación</label>
                        <input
                            type="date"
                            id="fecha-caducacion"
                            name="fecha-caducacion"
                            class="form-control"
                            required
                        />
                    </div>

                    <!-- Peso y Calorías (en la misma fila) -->
                    <div class="d-flex gap-3 w-100">
                        <!-- Peso -->
                        <div class="d-flex flex-column w-50">
                            <label for="peso" class="texto-label">Peso de la vianda</label>
                            <div class="input-group">
                                <input
                                    type="number"
                                    id="peso"
                                    name="peso"
                                    class="form-control"
                                    placeholder="Ingrese peso"
                                    required
                                    min="1"
                                    max="20"
                                    title="Debe ser un número entre 1 y 20 kilos."
                                />
                                <span class="input-group-text">kg</span>
                            </div>
                        </div>

                        <!-- Calorías -->
                        <div class="d-flex flex-column w-50">
                            <label for="calorias" class="texto-label">Calorías de la vianda</label>
                            <div class="input-group">
                                <input
                                    type="number"
                                    id="calorias"
                                    name="calorias"
                                    class="form-control"
                                    placeholder="Ingrese calorías"
                                    required
                                    min="1"
                                    max="20000"
                                    title="Debe ser un número entre 1 y 20000."
                                />
                                <span class="input-group-text">calorías</span>
                            </div>
                        </div>
                    </div>

                </div>

                    <!-- Botón donar -->
                    <div class="frame d-flex justify-content-center">
                        <button class="btn btn-primary btn-donar" role="button" type="submit">DONAR</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal de éxito -->
    <div id="successModal" class="modal" style="display: none;">
        <div class="modal-content">
            <p id="modalMessage">Donación realizada exitosamente.</p>
            <button id="confirmButton">OK</button>
        </div>
    </div>

    <script>
        document.querySelector("donacionViandaForm").addEventListener("submit", function (event) {
            event.preventDefault(); // Prevent default form submission

            const form = event.target;
            const formData = new FormData(form);

            // Send the form data via fetch
            fetch(form.action, {
                method: "POST",
                body: formData,
            })
                    .then(response => {
                        if (response.ok) {
                            return response.json();
                        } else {
                            throw new Error("Error submitting the form.");
                        }
                    })
                    .then(data => {
                        // Show the success modal
                        const modal = document.getElementById("successModal");
                        const message = document.getElementById("modalMessage");
                        message.textContent = data.message || "Donacion realizada exitosamente.";
                        modal.style.display = "flex";

                        // Handle modal confirmation button click
                        const confirmButton = document.getElementById("confirmButton");
                        confirmButton.addEventListener("click", function () {
                            modal.style.display = "none";
                            window.location.href = "/home"; // Redirect to home page
                        });
                    })
                    .catch(error => {
                        console.error("Error:", error);
                        alert("Hubo un error al enviar el formulario. Por favor, inténtalo de nuevo.");
                    });
        });
    </script>


    <!--para la barra que busca las heladeras-->
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchHeladeraDestino = document.getElementById("searchHeladeraDestino");
        const dropdownDestino = document.getElementById("nombre-heladera-destino");

        // Función para manejar búsquedas dinámicas
        function handleSearch(input, dropdown) {
            const searchValue = input.value.trim();

            if (searchValue.length >= 3) {
                fetch(`/heladeras/search?search=${encodeURIComponent(searchValue)}`)
                    .then((response) => response.json())
                    .then((data) => {
                        dropdown.innerHTML = ""; // Limpiar opciones existentes

                        if (data.length === 0) {
                            dropdown.classList.add("d-none"); // Ocultar el menú
                            input.setCustomValidity("No se encontraron coincidencias");
                        } else {
                            input.setCustomValidity(""); // Limpiar cualquier mensaje de error si hay resultados
                            dropdown.classList.remove("d-none");

                            data.forEach((heladera) => {
                                const option = document.createElement("option");
                                option.value = heladera.nombreHeladera; // Usar el nombre como valor
                                option.textContent = heladera.nombreHeladera;
                                dropdown.appendChild(option);

                                // Listener para cada opción (mousedown en lugar de click)
                                option.addEventListener("mousedown", function () {
                                    input.value = option.value; // Actualizar el campo de entrada
                                    dropdown.classList.add("d-none"); // Ocultar el menú desplegable
                                });
                            });

                            // Si solo hay una opción, seleccionarla automáticamente
                            if (data.length === 1) {
                                input.value = data[0].nombreHeladera;
                                dropdown.classList.add("d-none"); // Ocultar el menú desplegable
                            }
                        }
                    })
                    .catch((error) => {
                        console.error("Error fetching heladeras:", error);
                    });
            } else {
                dropdown.classList.add("d-none"); // Ocultar si hay menos de 3 letras
            }
        }

        // Listeners para búsquedas dinámicas
        searchHeladeraDestino.addEventListener("input", () =>
            handleSearch(searchHeladeraDestino, dropdownDestino)
        );

        // Actualizar el campo de entrada cuando se selecciona una opción del menú desplegable

        dropdownDestino.addEventListener("change", function () {
            searchHeladeraDestino.value = dropdownDestino.value;
            dropdownDestino.classList.add("d-none"); // Ocultar el menú después de seleccionar
        });
    });

    </script>


<!-- Para la barra que busca las comidas -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    const searchComidaOrigen = document.getElementById("searchComidaOrigen");
    const dropdownOrigen = document.getElementById("nombre-comida-origen");

    // Función para manejar búsquedas dinámicas
    function handleSearch(input, dropdown) {
        const searchValue = input.value.trim();

        if (searchValue.length >= 3) {
            fetch(`/comidas/search?search=${encodeURIComponent(searchValue)}`)
                .then((response) => response.json())
                .then((data) => {
                    dropdown.innerHTML = ""; // Limpiar opciones existentes

                    if (data.length === 0) {
                        dropdown.classList.add("d-none"); // Ocultar el menú
                        input.setCustomValidity("No se encontraron coincidencias");
                    } else {
                        input.setCustomValidity(""); // Limpiar cualquier mensaje de error si hay resultados
                        dropdown.classList.remove("d-none");

                        data.forEach((comida) => {
                            const option = document.createElement("option");
                            option.value = comida.nombre; // Usar el nombre como valor
                            option.textContent = comida.nombre;
                            dropdown.appendChild(option);

                            // Listener para cada opción (mousedown en lugar de click)
                            option.addEventListener("mousedown", function () {
                                input.value = option.value; // Actualizar el campo de entrada
                                dropdown.classList.add("d-none"); // Ocultar el menú desplegable
                            });
                        });

                        // Si solo hay una opción, seleccionarla automáticamente
                        if (data.length === 1) {
                            input.value = data[0].nombre;
                            dropdown.classList.add("d-none"); // Ocultar el menú desplegable
                        }
                    }
                })
                .catch((error) => {
                    console.error("Error fetching comidas:", error);
                });
        } else {
            dropdown.classList.add("d-none"); // Ocultar si hay menos de 3 letras
        }
    }

    // Listeners para búsquedas dinámicas
    searchComidaOrigen.addEventListener("input", () =>
        handleSearch(searchComidaOrigen, dropdownOrigen)
    );

    // Actualizar el campo de entrada cuando se selecciona una opción del menú desplegable
    dropdownOrigen.addEventListener("change", function () {
        searchComidaOrigen.value = dropdownOrigen.value;
        dropdownOrigen.classList.add("d-none"); // Ocultar el menú después de seleccionar
    });
});
</script>

{{/partial}}
