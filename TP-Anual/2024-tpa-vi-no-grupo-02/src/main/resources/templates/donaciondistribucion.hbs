{{#partial "contenido"}}
    <div class="home container-fluid">
        <div class="d-flex container-fluid flex-column flex-md-row justify-content-evenly p-0 m-0">
            <!-- Imagen a la izquierda -->
            <div class="d-flex flex-column justify-content-center w3-animate-left w3-animate-opacity non-square-distrib" style="animation-duration: 2s;">
                <img class="img-torcida" src="/public/img/donacion-vianda-alarg.jpg" alt="donacion vianda">
            </div>

            <!-- Contenedor de los campos, a la derecha de la imagen -->
            <div class="container-fluid flex-column p-5 col-md-6 w3-animate-bottom w3-animate-opacity" style="animation-duration: 2s;">
                <form id="donacionDistribucionForm" class="form_content"  action="/donacion/distribucion-viandas" method="POST">
                    <div class="container-fluid d-flex flex-column gap-3 my-3">

               <div class="d-flex justify-content-between my-3 w-100">
                   <!-- Campo Origen -->
                   <div class="d-flex flex-column w-48">
                       <div class="position-relative">
                           <input
                               type="text"
                               id="searchHeladeraOrigen"
                               placeholder="Heladera Origen"
                               class="form-control"
                               autocomplete="off"
                           />
                           <select
                               name="nombre-heladera-origen"
                               id="nombre-heladera-origen"
                               class="form-select position-absolute w-100 d-none mt-1"
                           >
                               <!-- Opciones dinámicas -->
                           </select>
                       </div>
                   </div>

                   <!-- Flecha para intercambiar -->
                   <button id="swapButton" class="btn btn-primary btn-light">
                       <i class="fa-solid fa-repeat"></i>
                   </button>

                   <!-- Campo Destino -->
                   <div class="d-flex flex-column w-48">
                       <div class="position-relative">
                           <input
                               type="text"
                               id="searchHeladeraDestino"
                               placeholder="Heladera Destino"
                               class="form-control"
                               autocomplete="off"
                           />
                           <select
                               name="nombre-heladera-destino"
                               id="nombre-heladera-destino"
                               class="form-select position-absolute w-100 d-none mt-1"
                           >
                               <!-- Opciones dinámicas -->
                           </select>
                       </div>
                   </div>
               </div>


                        <!-- Cantidad viandas -->
                        <div class="group-7">
                            <div class="group-8">
                                <div class="div-wrapper">
                                    <div class="group-3">
                                        <label for="cantidad-viandas" class="texto-label">Cantidad Viandas</label>
                                        <input
                                            type="number"
                                            id="cantidad-viandas"
                                            name="cantidad-viandas"
                                            class="form-control"
                                            placeholder="Ingrese cantidad"
                                            required
                                            min="1"
                                            max="1000"
                                            title="Debe ser un número entre 1 y 1000."
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Fecha distribución -->
                        <div class="group-wrapper">
                            <div class="div-wrapper">
                                <div class="group-3">
                                    <label for="fecha-colocacion" class="texto-label">Fecha Distribución</label>
                                    <input
                                        type="date"
                                        id="fecha-colocacion"
                                        name="fecha-colocacion"
                                        class="form-control"
                                        required
                                    />
                                </div>
                            </div>
                        </div>

                        <!-- Motivo distribución -->
                        <div class="group-4">
                            <div class="group-5">
                                <div class="group-6">
                                    <label for="motivo" class="texto-label">Motivo Distribución</label>
                                    <select id="motivo" name="motivo" class="form-control" required>
                                        <option value="DESPERFECTO_HELADERA">Desperfecto de heladera</option>
                                        <option value="FALTA_DE_VIANDAS">Falta de viandas</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botón donar -->
                    <div class="frame d-flex justify-content-center">
                        <button class="btn btn-primary btn-donar" role="button" type="submit">DONAR</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!--para la barra que busca las heladeras-->
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchHeladeraOrigen = document.getElementById("searchHeladeraOrigen");
        const searchHeladeraDestino = document.getElementById("searchHeladeraDestino");
        const dropdownOrigen = document.getElementById("nombre-heladera-origen");
        const dropdownDestino = document.getElementById("nombre-heladera-destino");
        const swapButton = document.getElementById("swapButton");

        // Intercambiar valores entre origen y destino
        swapButton.addEventListener("click", function (event) {
            event.preventDefault(); // Evitar que el botón recargue la página
            const temp = searchHeladeraOrigen.value;
            searchHeladeraOrigen.value = searchHeladeraDestino.value;
            searchHeladeraDestino.value = temp;
        });

        // Función para manejar búsquedas dinámicas
        function handleSearch(input, dropdown) {
            const searchValue = input.value.trim();

            if (searchValue.length >= 3) {
                fetch(`/heladeras/search?search=${encodeURIComponent(searchValue)}`)
                    .then((response) => response.json())
                    .then((data) => {
                        dropdown.innerHTML = ""; // Limpiar opciones existentes

                        if (data.length === 0) {
                            dropdown.classList.add("d-none"); // Ocultar el menú
                            input.setCustomValidity("No se encontraron coincidencias");
                        } else {
                            input.setCustomValidity(""); // Limpiar cualquier mensaje de error si hay resultados
                            dropdown.classList.remove("d-none");

                            data.forEach((heladera) => {
                                const option = document.createElement("option");
                                option.value = heladera.nombreHeladera; // Usar el nombre como valor
                                option.textContent = heladera.nombreHeladera;
                                dropdown.appendChild(option);

                                // Listener para cada opción (mousedown en lugar de click)
                                option.addEventListener("mousedown", function () {
                                    input.value = option.value; // Actualizar el campo de entrada
                                    dropdown.classList.add("d-none"); // Ocultar el menú desplegable
                                });
                            });

                            // Si solo hay una opción, seleccionarla automáticamente
                            if (data.length === 1) {
                                input.value = data[0].nombreHeladera;
                                dropdown.classList.add("d-none"); // Ocultar el menú desplegable
                            }
                        }
                    })
                    .catch((error) => {
                        console.error("Error fetching heladeras:", error);
                    });
            } else {
                dropdown.classList.add("d-none"); // Ocultar si hay menos de 3 letras
            }
        }

        // Listeners para búsquedas dinámicas
        searchHeladeraOrigen.addEventListener("input", () =>
            handleSearch(searchHeladeraOrigen, dropdownOrigen)
        );
        searchHeladeraDestino.addEventListener("input", () =>
            handleSearch(searchHeladeraDestino, dropdownDestino)
        );

        // Actualizar el campo de entrada cuando se selecciona una opción del menú desplegable
        dropdownOrigen.addEventListener("change", function () {
            searchHeladeraOrigen.value = dropdownOrigen.value;
            dropdownOrigen.classList.add("d-none"); // Ocultar el menú después de seleccionar
        });

        dropdownDestino.addEventListener("change", function () {
            searchHeladeraDestino.value = dropdownDestino.value;
            dropdownDestino.classList.add("d-none"); // Ocultar el menú después de seleccionar
        });
    });

    </script>

    <div id="successModal" class="modal" style="display: none;">
        <div class="modal-content">
            <p id="modalMessage">Donacion realizada exitosamente.</p>
            <button id="confirmButton">OK</button>
        </div>
    </div>

    <script>
        document.querySelector("donacionDistribucionForm").addEventListener("submit", function (event) {
            event.preventDefault(); // Prevent default form submission

            const form = event.target;
            const formData = new FormData(form);

            // Send the form data via fetch
            fetch(form.action, {
                method: "POST",
                body: formData,
            })
                    .then(response => {
                        if (response.ok) {
                            return response.json();
                        } else {
                            throw new Error("Error submitting the form.");
                        }
                    })
                    .then(data => {
                        // Show the success modal
                        const modal = document.getElementById("successModal");
                        const message = document.getElementById("modalMessage");
                        message.textContent = data.message || "Donacion realizada exitosamente.";
                        modal.style.display = "flex";

                        // Handle modal confirmation button click
                        const confirmButton = document.getElementById("confirmButton");
                        confirmButton.addEventListener("click", function () {
                            modal.style.display = "none";
                            window.location.href = "/home"; // Redirect to home page
                        });
                    })
                    .catch(error => {
                        console.error("Error:", error);
                        alert("Hubo un error al enviar el formulario. Por favor, inténtalo de nuevo.");
                    });
        });
    </script>

{{/partial}}

{{> templates/layout}}
